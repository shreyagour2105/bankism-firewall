# BANKISM AI Firewall Environment Configuration
# NOTE: The system functions 100% locally in Deterministic Mode without any API keys.
# If you wish to enable optional LLM-assisted threat evaluation (advisory only), configure one of:

# Optional Gemini API key, used server-side for advisory prompt analysis
GEMINI_API_KEY=

# Use a private key of at least 32 characters in production. Local development has a fallback.
FIREWALL_SIGNING_KEY=

# Optional administrator secret for production mock ledger reset
ADMIN_RESET_TOKEN=

# Environment Mode: 'development' | 'production'
NODE_ENV=development
