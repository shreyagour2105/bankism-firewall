# BANKISM AI Firewall Environment Configuration
# NOTE: The system functions 100% locally in Deterministic Mode without any API keys.
# If you wish to enable optional LLM-assisted threat evaluation (advisory only), configure one of:

# Optional Gemini API Key (Server-side only, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional LLM Model name (defaults to gemini-1.5-flash or local fallback)
GEMINI_MODEL=gemini-1.5-flash

# Environment Mode: 'development' | 'production'
NODE_ENV=development
